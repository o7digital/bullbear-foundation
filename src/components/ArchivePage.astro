---
import Layout from '../layouts/Layout.astro';import PageIntro from './PageIntro.astro';import ActivityCard from './ActivityCard.astro';import {getCollection} from 'astro:content';import indexes from '../data/archive-indexes.json';

interface Props{index:typeof indexes[number]}
const {index}=Astro.props;const all=await getCollection('activities');const activities=index.activityIds.map(id=>all.find(a=>a.id===id)).filter((a):a is NonNullable<typeof a>=>Boolean(a));
---
<Layout title={`${index.title} | Fundación Bull & Bear`} description={`Consulta ${index.title.toLowerCase()} de Bull & Bear Foundation: relatos, imágenes y talleres conservados en su archivo histórico.`}><PageIntro eyebrow="Archivo histórico" title={index.title} description="Recuperamos los encuentros y relatos de nuestro archivo. Estas actividades no son convocatorias actuales."/><div class="container page-body"><div class="archive-links">{index.indexIds.filter(id=>indexes.some(i=>i.id===id)).map(id=><a class="text-link" href={`/${id}/`}>{indexes.find(i=>i.id===id)?.title} ↗</a>)}</div><h2 class="sr-only">Encuentros de este archivo</h2><div class="activity-grid archive-grid">{activities.map(a=><ActivityCard activity={a}/>)}</div><p class="archive-note">La selección conserva los enlaces del índice original. Las fechas confirmadas se indican en cada relato.</p><a class="text-link" href="/actividades-bb-foundation/">Ver todas las actividades ↗</a></div></Layout>
