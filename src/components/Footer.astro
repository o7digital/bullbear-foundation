---
import {Image} from 'astro:assets';import {media,logo} from '../data/media';import {site} from '../data/site';
---
<footer class="site-footer">
 <div class="container">

  <div class="footer-grid">
   <div class="footer-brand"><a href="/" aria-label="Inicio"><Image src={media(logo)} width={240} height={57} alt="Bull & Bear Foundation" /></a><p>Apoyo social, talleres y voluntariado.<br/>Ciudad de México.</p></div>
   <div><span class="eyebrow">Explora</span><a href="/quienes-somos/">La fundación</a><a href="/programas/">Nuestra labor</a><a href="/actividades-bb-foundation/">Actividades</a><a href="/galeria/">Galería</a><a href="/transparencia/">Transparencia</a></div>
   <div><span class="eyebrow">Súmate</span><a href="/como-ayudar/">Cómo ayudar</a><a href="/voluntariado/">Voluntariado</a><a href="/donar-ahora/">Hacer un donativo</a><a href="https://www.facebook.com/bullandbearfoundation" target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href="https://www.instagram.com/bullbearfoundation/" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://www.youtube.com/channel/UCvHyVLlBmyLkjAdrdPzyKww" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
   <div><span class="eyebrow">Conversemos</span><a class="email" href={`mailto:${site.email}`}>{site.email}</a><a href="tel:+525536888077">{site.phone}</a><p>{site.address}</p></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Fundación Bull&Bear A.C.</span><a href="/aviso-de-privacidad/">Aviso de privacidad</a></div>
 </div>
</footer>
