---
import { Image } from 'astro:assets';
import {studioRecord} from '../data/cms';
import {media} from '../data/media';
const hero=studioRecord('site-hero');
const originalPhotograph=media(hero?.image||'853a574a8c-primer-plano-diversas-personas-uniendo-sus-manos.jpg');
import '@fontsource/poppins/latin-700.css';
---
<section class="original-hero" aria-labelledby="original-hero-title" data-source="https://www.bullandbear-foundation.com/">
  <Image
    class="original-hero-photograph"
    src={originalPhotograph}
    alt={hero?.alt||"Un grupo de personas une sus manos en un gesto de ayuda mutua"}
    style={`object-position:${hero?.position||'50% 50%'}`}
    width={1200}
    height={675}
    widths={[600, 900, 1200]}
    sizes="100vw"
    format="webp"
    quality={90}
    loading="eager"
    fetchpriority="high"
  />
  <div class="original-hero-height">
    <div class="original-hero-inner">
      <div class="original-hero-frame">
        <div class="original-hero-copy">
          <h1 id="original-hero-title">{hero?.title||'Una cultura universal'}</h1>
          <p class="original-hero-subtitle">{hero?.body||'una ayúda mutua'}</p>
          <a class="original-hero-button" href={hero?.button_url||'/contacto/'}>{hero?.button_label||'¿Deseas ayudar?'}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* Geometry, typography and crop recovered from the live WordPress hero. */
  .original-hero {
    position: relative;
    isolation: isolate;
    padding: 0 0 20px;
    color: #fff;
    font-family: 'Poppins', sans-serif;
  }
  .original-hero-photograph {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .original-hero-height { min-height: 90vh; display: flex; align-items: center; }
  .original-hero-inner { width: 100%; padding: 0 30px; }
  .original-hero-frame { max-width: 1260px; margin: 0 auto; }
  .original-hero-copy { width: 60%; padding: 40px 0 30px 40px; border-left: 10px solid #74aa45; }
  .original-hero-copy h1 {
    margin: 0 0 10px;
    color: #fff;
    font: 700 70px/90.3px 'Poppins', sans-serif;
    letter-spacing: normal;
  }
  .original-hero-subtitle {
    margin: 0;
    color: #fff;
    font: 700 24px/31.9167px 'Poppins', sans-serif;
    letter-spacing: normal;
  }
  .original-hero-button {
    display: inline-block;
    margin-top: 55px;
    padding: 18px 35px;
    border: 2px solid #74aa45;
    border-radius: 0;
    color: #fff;
    background: transparent;
    font: 700 16px/24.9667px 'Poppins', sans-serif;
    letter-spacing: normal;
    text-align: center;
  }
  .original-hero-button:hover, .original-hero-button:focus-visible { background: #83bd45; color: #1d1c1c; }
  @media (max-width: 1024px) {
    .original-hero { padding: 50px 0; }
    .original-hero-height { min-height: 44vh; }
    .original-hero-frame { max-width: 1024px; }
    .original-hero-copy { width: 80%; }
    .original-hero-copy h1 { font-size: 50px; line-height: 70px; letter-spacing: .2px; }
    .original-hero-subtitle { font-size: 22px; line-height: 33px; letter-spacing: .2px; }
  }
  @media (max-width: 767px) {
    .original-hero { padding: 30px 0 60px 20px; }
    .original-hero-height { min-height: 18vh; }
    .original-hero-inner { padding: 0; }
    .original-hero-frame { max-width: 767px; }
    .original-hero-copy { width: 100%; padding: 30px 40px 30px 20px; }
    .original-hero-copy h1 { font-size: 35px; line-height: 49px; letter-spacing: .1px; }
    .original-hero-subtitle { padding-right: 40px; }
  }
</style>
