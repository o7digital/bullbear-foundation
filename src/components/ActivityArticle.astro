---
import Layout from '../layouts/Layout.astro';import PageIntro from './PageIntro.astro';import PhotoGallery from './PhotoGallery.astro';import type {CollectionEntry} from 'astro:content';import {site} from '../data/site';

const {activity}=Astro.props as {activity:CollectionEntry<'activities'>};const a=activity.data;
const article={'@type':'Article',headline:a.title,description:a.summary,...(a.publishedAt?{datePublished:a.publishedAt}:{}),...(a.modifiedAt?{dateModified:a.modifiedAt}:{}),author:{'@type':'Organization',name:site.name},publisher:{'@type':'Organization',name:site.name},mainEntityOfPage:new URL(`/${a.id}/`,site.url).href};
---
<Layout title={`${a.title} | Fundación Bull & Bear`} description={`${a.title}. ${a.summary}`} article={article}><PageIntro eyebrow="Archivo de actividades" title={a.title} description={a.summary}/><div class="container page-body"><div class="article-layout"><article class="prose">{a.paragraphs.map(p=><p>{p}</p>)}{a.impact&&<p class="archive-note"><strong>{a.impact.count} {a.impact.label}</strong><br/>Dato del relato original para {a.impact.period}. Corresponde únicamente a esta actividad.</p>}<p class="archive-note">Esta es una actividad del archivo histórico de la fundación. Para conocer las posibilidades actuales de participación, <a href="/contacto/">ponte en contacto con nosotros</a>.</p></article><aside class="article-sidebar"><p class="eyebrow">Sobre este encuentro</p><dl><div><dt>Fecha de actividad</dt><dd>{a.dateLabel}</dd></div><div><dt>Eje</dt><dd>{a.category}</dd></div><div><dt>Archivo</dt><dd>Bull & Bear Foundation</dd></div></dl><a class="button" href="/voluntariado/">Súmate como voluntario ↗</a></aside></div>{a.images.length>0&&<section class="gallery-section"><p class="eyebrow">El encuentro en imágenes</p><h2>Momentos compartidos.</h2><PhotoGallery files={a.images} title={a.title}/></section>}<a class="text-link" href="/actividades-bb-foundation/">← Volver a todas las actividades</a></div></Layout>
