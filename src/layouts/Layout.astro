---
import sansFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';import serifFont from '@fontsource/lora/files/lora-latin-400-normal.woff2?url';
import StudioMedia from '../components/StudioMedia.astro';
import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import {site} from '../data/site';
import '@fontsource/dm-sans/latin-400.css';import '@fontsource/dm-sans/latin-500.css';import '@fontsource/dm-sans/latin-600.css';import '@fontsource/lora/latin-400.css';import '@fontsource/lora/cyrillic-400.css';import '@fontsource/lora/cyrillic-400-italic.css';import '@fontsource/lora/latin-400-italic.css';import '../styles/global.css';
interface Props{title:string;description:string;image?:string;article?:Record<string,unknown>;noindex?:boolean;}
const {title,description,image='/social.jpg',article,noindex=false}=Astro.props;
const mediaSection:Record<string,string>={'/':'inicio','/quienes-somos/':'fundacion','/programas/':'programas','/actividades-bb-foundation/':'actividades','/galeria/':'galeria','/transparencia/':'transparencia','/voluntariado/':'participar','/contacto/':'contacto'};
const canonical=new URL(Astro.url.pathname,site.url).href;
const schema={'@context':'https://schema.org','@type':'NGO',name:site.name,legalName:site.legalName,url:site.url,email:site.email,telephone:'+525536888077',foundingDate:'2016',sameAs:['https://www.facebook.com/bullandbearfoundation','https://www.instagram.com/bullbearfoundation/']};
---
<!doctype html><html lang="es-MX"><head><meta charset="UTF-8"/><script is:inline>document.documentElement.classList.add('js');</script><link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin/><link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#163D2D"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={!__SITE_LIVE__||noindex?'noindex, nofollow':'index, follow'}/><link rel="icon" href="/favicon.png" type="image/png"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:locale" content="es_MX"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,site.url).href}/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>{article&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...article}).replace(/</g,'\\u003c')}/>}{Astro.url.pathname!=='/'&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:site.url+'/'},{'@type':'ListItem',position:2,name:title.split(' | ')[0],item:canonical}]}).replace(/</g,'\\u003c')}/>}</head><body><a class="skip-link" href="#contenido">Saltar al contenido</a><Header/><main id="contenido"><slot/>{mediaSection[Astro.url.pathname]&&<StudioMedia section={mediaSection[Astro.url.pathname]}/>}</main><Footer/></body></html>
