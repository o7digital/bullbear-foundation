---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import PhotoGallery from '../components/PhotoGallery.astro';import {getCollection} from 'astro:content';const activities=(await getCollection('activities')).filter(a=>a.data.images.length>0).sort((a,b)=>(b.data.date??'').localeCompare(a.data.date??''));
---
<Layout title="Galería de nuestras acciones | Fundación Bull & Bear" description="Fotografías de los talleres, visitas y encuentros de Bull & Bear Foundation. Explora los álbumes de nuestro archivo de actividades."><PageIntro eyebrow="Galería" title="La solidaridad<br/><em>tiene muchos rostros.</em>" description="Una mirada a los encuentros y a las personas que dan sentido a nuestra labor."/><div class="container page-body">{activities.map(a=><section class="gallery-section"><p class="eyebrow">{a.data.dateLabel}</p><h2><a href={`/${a.id}/`}>{a.data.title}</a></h2><PhotoGallery files={a.data.images.slice(0,3)} title={a.data.title}/><a class="text-link" href={`/${a.id}/`}>Ver álbum y relato completo ↗</a></section>)}</div></Layout>
