---
import Layout from '../layouts/Layout.astro';import Arrow from '../components/Arrow.astro';import ActivityCard from '../components/ActivityCard.astro';import {getCollection} from 'astro:content';import {Image} from 'astro:assets';import {media,hero,community} from '../data/media';import {site} from '../data/site';
const programs=(await getCollection('programs')).sort((a,b)=>a.data.number.localeCompare(b.data.number));
const activities=await getCollection('activities');
const featured=['talleres-en-casa-refugiados-a-c','taller-de-empatia-tapete-de-movimiento','taller-cuentos-mexicanos-dia-internacional-del-libro-yolia'].map(id=>activities.find(a=>a.id===id)!).filter(Boolean);
---
<Layout title="Fundación Bull & Bear | Ayuda y voluntariado en México" description="Convertimos la solidaridad en acciones. Conoce la labor de Bull & Bear Foundation y cómo participar para acompañar a personas en situación de vulnerabilidad en México.">
 <section class="hero container"><div class="hero-grid"><div class="hero-copy"><p class="eyebrow eyebrow-dot">Una cultura universal, una ayuda mutua</p><h1>La solidaridad<br/>se convierte<br/>en <em>acciones.</em></h1><p class="hero-description">Acompañamos a personas en situación de vulnerabilidad en México. Con cercanía, con compromiso y, sobre todo, contigo.</p><div class="hero-actions"><a class="button" href="/como-ayudar/">Quiero ayudar <Arrow diagonal/></a><a class="text-link" href="/quienes-somos/">Conoce nuestra labor <Arrow/></a></div><p class="hero-note">Desde 2016, construyendo vínculos que importan.</p></div><figure class="hero-photo" style="margin:0"><Image src={media(hero)} alt="Un abrazo entre una voluntaria y una persona mayor durante una visita de la fundación" widths={[500,800,1200]} sizes="(max-width: 767px) 95vw, 46vw" width={900} height={1100} format="webp" loading="eager" fetchpriority="high" quality={85}/><div class="hero-seal" aria-hidden="true"><span>Cada gesto</span><span class="seal-flower">✳</span><span>hace la diferencia</span></div><figcaption class="hero-caption"><span>Estar presentes también es ayudar.</span><span>01 — Nuestra esencia</span></figcaption></figure></div></section>
 <div class="mission-strip"><div class="container"><p>Creemos en las personas. <em>Y en lo que podemos hacer juntas.</em></p><span>Servicio · Cercanía · Solidaridad</span></div></div>
 <section class="section container"><div class="section-heading"><div><p class="eyebrow">01 / Nuestra razón de ser</p><h2>La ayuda empieza<br/>con <em>estar cerca.</em></h2></div><p>Escuchamos, compartimos y actuamos. Nuestra misión es brindar ayuda a grupos vulnerables como una forma de retribuir a nuestra sociedad.</p></div><div class="program-grid">{programs.map((p,i)=><article class="program-card"><span class="program-number">0{i+1}</span><svg class="program-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">{i===0?<><path d="M5 22h8l6 5 7-5h8M5 22v10h11l8-3 10-7M13 22l5-5 9 5M20 13c-9-5-8-11-4-11 2 0 3 1 4 3 1-2 2-3 4-3 5 0 6 6-4 11Z"/></>:i===1?<><path d="M20 10C13 5 6 5 3 7v25c5-3 11-3 17 1 6-4 12-4 17-1V7c-4-2-11-2-17 3Zm0 0v23M8 13h7M8 18h7M25 13h7M25 18h7"/></>:i===2?<><circle cx="20" cy="9" r="4"/><circle cx="8" cy="14" r="3"/><circle cx="32" cy="14" r="3"/><path d="M12 31v-8a8 8 0 0 1 16 0v8M2 32v-9a6 6 0 0 1 10-4m16 0a6 6 0 0 1 10 4v9M16 38v-9m8 0v9"/></>:<><path d="M20 36V19m0 8C6 27 5 14 5 8c10 0 15 5 15 12m0 3c0-13 9-17 16-18 1 12-5 22-16 22M9 13l11 13m11-14L20 24"/></>}</svg><h3>{p.data.title}</h3><p>{p.data.summary}</p><a class="text-link" href={`/programas/#${p.id}`}>Conoce este eje <Arrow/></a></article>)}</div></section>
 <section class="section activity-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / Historias que nos unen</p><h2>Pequeñas acciones.<br/><em>Encuentros que dejan huella.</em></h2></div><a class="text-link" href="/actividades-bb-foundation/">Explora nuestras actividades <Arrow diagonal/></a></div><div class="activity-grid">{featured.map(a=><ActivityCard activity={a}/>)}</div></div></section>
 <section class="section container"><div class="split"><div class="split-image"><Image src={media(community)} alt="Participantes y voluntarios conviven al aire libre durante una actividad de la fundación" widths={[500,800,1100]} sizes="(max-width: 767px) 90vw, 44vw" width={800} height={760} format="webp" loading="lazy"/></div><div class="split-copy"><p class="eyebrow">03 / Lo que nos mueve</p><h2>Detrás de cada acción,<br/><em>hay una persona.</em></h2><p>Un taller que abre una conversación. Una visita que se convierte en amistad. Un espacio para recordar de dónde venimos. Así toma forma nuestra labor.</p><div class="qualitative-list"><div><span>↗</span> Talleres para aprender y expresarse.</div><div><span>↗</span> Compañía para las personas mayores.</div><div><span>↗</span> Espacios de encuentro y apoyo comunitario.</div></div><a class="text-link" href="/actividades-bb-foundation/">Conoce los relatos de nuestras acciones <Arrow/></a></div></div></section>
 <section class="section transparency-band"><div class="container transparency-inner"><div><p class="eyebrow">04 / La confianza se construye</p><h2>Actuar con el corazón.<br/><em>Compartir con claridad.</em></h2><p>Conoce los documentos publicados por la fundación y acércate a nosotros para solicitar información sobre nuestra labor.</p><a class="button button-light" href="/transparencia/">Nuestra transparencia <Arrow diagonal/></a></div><div class="document-preview"><svg viewBox="0 0 40 48" fill="none" stroke="currentColor" aria-hidden="true"><path d="M5 2h20l10 10v34H5V2Zm20 0v11h10M12 23h16M12 29h16M12 35h10"/></svg><div><p class="eyebrow">Documentación de la fundación</p><h3>Información accesible.<br/>Una conversación abierta.</h3><p>Consulta los documentos y reconocimientos recuperados del archivo institucional.</p><a class="text-link" href="/transparencia/">Consultar documentos <Arrow/></a></div></div></div></section>
 <section class="participate container"><p class="eyebrow">05 / Hay muchas formas de sumar</p><h2>Tu tiempo. Tu apoyo.<br/><em>Una nueva posibilidad.</em></h2><p>No necesitas tener todas las respuestas. Las ganas de ayudar son un buen lugar para empezar.</p><div class="participate-actions"><a class="button" href="/voluntariado/">Quiero ser voluntario <Arrow diagonal/></a><a class="button button-outline" href="/donar-ahora/">Hacer un donativo <Arrow diagonal/></a></div></section>
 <section class="contact-strip"><div class="container"><div><p class="eyebrow">06 / El primer paso es conversar</p><h2>¿Tienes una idea para ayudar? Queremos escucharte.</h2></div><a class="text-link" href={`mailto:${site.email}`}>Escríbenos <Arrow diagonal/></a></div></section>
</Layout>
