---
import EditableText from '../components/EditableText.astro';
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Arrow from '../components/Arrow.astro';import {Image} from 'astro:assets';import {media,community} from '../data/media';
---
<Layout title="Quiénes somos | Fundación Bull & Bear" description="Desde 2016, Bull & Bear Foundation trabaja para brindar ayuda a grupos vulnerables. Conoce nuestra historia, misión, valores y equipo."><PageIntro eyebrow="La fundación" title="La cercanía es<br/>nuestra <em>forma de ayudar.</em>" description="Somos una organización sin fines de lucro que cree en el poder de las personas para acompañar, compartir y transformar su entorno."/><div class="container page-body"><Image class="wide-image" src={media(community)} alt="Encuentro comunitario de participantes y voluntarios de Bull & Bear Foundation" width={1280} height={580} widths={[600,1000,1400]} sizes="90vw" format="webp" loading="eager"/><section class="section split"><div><p class="eyebrow">Nuestro origen</p><h2>Una iniciativa.<br/><em>Muchas manos.</em></h2><div class="timeline"><div><EditableText as="h3" contentId="copy-e760dcac63b391236501c09b" fallback={"2016 — El comienzo"}/><EditableText as="p" contentId="copy-50492daf2ea77aff5fe3f8a1" fallback={"La fundación nace con la iniciativa de brindar apoyo a diferentes grupos vulnerables y crear una relación cercana que permita comprender y atender sus necesidades."}/></div><div><EditableText as="h3" contentId="copy-65b8688f7ec9e000c50e9fc0" fallback={"Una ayuda mutua"}/><EditableText as="p" contentId="copy-c99f0f5b88efa7e24aa71d53" fallback={"Escuchar a cada persona y trabajar en comunidad es parte de nuestra filosofía. Cada encuentro nos ayuda a entender cómo podemos contribuir."}/></div></div></div><div class="split-copy"><p class="eyebrow">Nuestra misión</p><h2>Retribuir a<br/>nuestra sociedad.</h2><EditableText as="p" contentId="copy-ec7e169dfa6fb2f2225dcdae" fallback={"Brindar ayuda a grupos vulnerables, como retribución a nuestra sociedad."}/><EditableText as="h3" contentId="copy-c0c6f05958af96c7263f4c2b" fallback={"Nuestra visión"} style="margin-top:30px"/><EditableText as="p" contentId="copy-2f8e9abd994e973f1b87cb0a" fallback={"Ser una fundación sólida, que cuente con la capacidad de desempeñar proyectos de contribución de gran impacto."}/><a class="text-link" href="/programas/">Así llevamos nuestra misión a la práctica <Arrow/></a></div></section><section><p class="eyebrow">Nuestros valores</p><EditableText as="h2" contentId="copy-86888fda75df1f41fb940526" fallback={"Lo que guía cada encuentro."}/><div class="values-grid">{['Servicio','Compromiso','Solidaridad','Proximidad','Humanismo','Honestidad'].map(v=><div class="value">{v}</div>)}</div></section><section class="section"><div class="section-heading"><div><p class="eyebrow">Personas que suman</p><h2>Al frente de <em>la fundación.</em></h2></div><EditableText as="p" contentId="copy-6118854ab8cc5be6415604d5" fallback={"El equipo directivo presentado en la información institucional de Bull & Bear Foundation."}/></div><div class="team-grid"><article><Image src={media('fbc257299c-Foto-Carlos-Reyes.jpg')} width={550} height={450} format="webp" alt="Carlos Reyes" loading="lazy"/><EditableText as="h3" contentId="copy-320dcb7918fe6c553292e3f7" fallback={"Carlos Reyes"}/><EditableText as="p" contentId="copy-6cec0b07bc65ee20f79ef428" fallback={"Presidente, según la página institucional de origen."}/></article><article><Image src={media('2b8e608dbe-Image-1.jpg')} width={550} height={450} format="webp" alt="Rodrigo Pérez" loading="lazy"/><EditableText as="h3" contentId="copy-10563199474cc0d2410c7267" fallback={"Rodrigo Pérez"}/><EditableText as="p" contentId="copy-d877e7e252786a00b34b4f9f" fallback={"Secretario, según la página institucional de origen."}/></article></div></section><a class="button" href="/como-ayudar/">Sé parte de esta historia <Arrow diagonal/></a></div></Layout>
