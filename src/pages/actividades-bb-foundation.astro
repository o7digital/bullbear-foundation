---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import ActivityCard from '../components/ActivityCard.astro';import Filters from '../components/Filters';import {getCollection} from 'astro:content';const activities=(await getCollection('activities')).sort((a,b)=>(b.data.date??'').localeCompare(a.data.date??'')||a.data.title.localeCompare(b.data.title));const years=[...new Set(activities.map(a=>a.data.year))].sort((a,b)=>a==='sin-fecha'?1:b==='sin-fecha'?-1:b.localeCompare(a));const categories=[...new Set(activities.map(a=>a.data.category))].sort();
---
<Layout title="Actividades y archivo de acciones | Fundación Bull & Bear" description="Explora las actividades de Bull & Bear Foundation: talleres, encuentros y acciones comunitarias. Consulta sus relatos, fotografías y fechas históricas."><PageIntro eyebrow="Actividades" title="Historias de una<br/><em>ayuda compartida.</em>" description="Talleres, visitas y encuentros que forman parte de nuestra historia. Un archivo de lo que hacemos cuando nos unimos."/><div class="container page-body"><Filters client:idle years={years} categories={categories}/><noscript><p class="archive-note">Estás viendo todas las actividades. Los filtros requieren JavaScript; puedes consultar cada relato desde esta lista.</p></noscript><h2 class="sr-only">Actividades del archivo</h2><div class="activity-grid archive-grid">{activities.map(a=><ActivityCard activity={a}/>)}</div><div class="archive-links"><a class="text-link" href="/resumen-de-actividades-foundation-2023/">Archivo 2023 ↗</a><a class="text-link" href="/calendario-de-actividades-2024/">Archivo 2024 ↗</a><a class="text-link" href="/participar-en-eventos-junio-2025/">Agenda histórica 2025 ↗</a><a class="text-link" href="/galeria/">Galería fotográfica ↗</a></div><p class="archive-note">Estas actividades forman parte del archivo histórico. Las fechas se muestran cuando están indicadas en el relato original; no son convocatorias vigentes.</p></div></Layout>
