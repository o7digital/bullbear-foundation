---
import EditableText from '../components/EditableText.astro';
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Arrow from '../components/Arrow.astro';
---
<Layout title="Cómo ayudar y participar | Fundación Bull & Bear" description="Dona, comparte tu tiempo como voluntario o suma a tu empresa. Conoce las formas de participar con Bull & Bear Foundation en México."><PageIntro eyebrow="Cómo ayudar" title="Hay un lugar<br/>para <em>tu solidaridad.</em>" description="Cada gesto cuenta. Encuentra una manera de participar que conecte con lo que puedes y quieres compartir."/><div class="container page-body"><div class="help-grid"><article class="help-card"><span class="eyebrow">01 / Comparte tu tiempo</span><EditableText as="h2" contentId="copy-6aac6b4c992fa8abeca5aaf7" fallback={"Voluntariado"}/><EditableText as="p" contentId="copy-9077f2d2881e1b1baa95d8ce" fallback={"Participa en actividades de acompañamiento, talleres y encuentros. Cuéntanos tus intereses y habilidades para conocer las posibilidades de colaboración."}/><a class="text-link" href="/voluntariado/">Quiero ser voluntario <Arrow/></a></article><article class="help-card"><span class="eyebrow">02 / Sostén una acción</span><EditableText as="h2" contentId="copy-2f607e429ebb1f62d67700f1" fallback={"Haz un donativo"}/><EditableText as="p" contentId="copy-04adb1c35024be02908e2d1c" fallback={"Apoya el trabajo de la fundación con una aportación. Consulta el canal de donación y pregunta por los apoyos en especie que se necesitan antes de organizar una entrega."}/><a class="text-link" href="/donar-ahora/">Conoce cómo donar <Arrow/></a></article><article class="help-card"><span class="eyebrow">03 / Multiplica la ayuda</span><EditableText as="h2" contentId="copy-d33d7e432dbb1646a68c2ea6" fallback={"Suma a tu comunidad"}/><EditableText as="p" contentId="copy-4cde7af348e3b1081386373d" fallback={"Comparte nuestra labor o propón una colaboración desde tu empresa, escuela o grupo. Conversemos para encontrar una forma de participar juntos."}/><a class="text-link" href="/contacto/">Propón una colaboración <Arrow/></a></article></div><section class="section split"><div><p class="eyebrow">Antes de empezar</p><h2>La mejor ayuda<br/>empieza por <em>escuchar.</em></h2></div><div class="prose"><EditableText as="p" contentId="copy-7cdf672aa0b91849f0329143" fallback={"Las necesidades de cada institución y de cada actividad son distintas. Contáctanos antes de reunir productos o programar una visita para confirmar qué se necesita y cómo hacerlo llegar."}/><a class="button" href="/contacto/">Hablemos de tu idea <Arrow diagonal/></a></div></section></div></Layout>
