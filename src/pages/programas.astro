---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import Arrow from '../components/Arrow.astro';import {getCollection} from 'astro:content';import {Image} from 'astro:assets';import {media} from '../data/media';const programs=(await getCollection('programs')).sort((a,b)=>a.data.number.localeCompare(b.data.number));
---
<Layout title="Nuestra labor y programas | Fundación Bull & Bear" description="Asistencia social, talleres de orientación, voluntariado y acciones comunitarias: conoce los ejes de trabajo de Bull & Bear Foundation."><PageIntro eyebrow="Nuestra labor" title="Escuchar. Acompañar.<br/><em>Actuar juntos.</em>" description="Nuestra labor toma distintas formas, con un mismo propósito: brindar apoyo cercano a las personas que lo necesitan."/><div class="container page-body">{programs.map(p=><section id={p.id} class="program-detail split"><div class="split-image"><Image src={media(p.data.image)} alt={p.data.title+' — fotografía del archivo de la fundación'} width={750} height={580} widths={[400,750,1000]} sizes="(max-width:767px) 90vw,44vw" format="webp" loading="lazy"/></div><div><p class="eyebrow">Eje {p.data.number}</p><h2>{p.data.title}</h2><p>{p.data.body}</p><a class="text-link" href={p.id==='voluntariado'?'/voluntariado/':'/actividades-bb-foundation/'}>{p.id==='voluntariado'?'Quiero participar':'Conoce las actividades'} <Arrow/></a></div></section>)}</div></Layout>
