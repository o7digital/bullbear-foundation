---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import {Image} from 'astro:assets';import {media,community} from '../data/media';import {site} from '../data/site';
---
<Layout title="Voluntariado: comparte tu tiempo | Fundación Bull & Bear" description="Comparte tus habilidades y tu tiempo con Bull & Bear Foundation. Conoce cómo acercarte al equipo para participar en actividades de voluntariado."><PageIntro eyebrow="Voluntariado" title="Estar presente.<br/><em>Eso también transforma.</em>" description="Tu tiempo y tus habilidades pueden convertirse en compañía, aprendizaje y nuevos vínculos."/><div class="container page-body split"><div><Image class="wide-image" src={media(community)} alt="Voluntarios y participantes en un encuentro al aire libre" width={850} height={850} format="webp" loading="eager"/></div><div><p class="eyebrow">Cómo participar</p><h2>Demos el primer paso.</h2><ol class="steps"><li><h3>Cuéntanos de ti</h3><p>Escríbenos con tus intereses, habilidades y disponibilidad.</p></li><li><h3>Conoce las oportunidades</h3><p>El equipo te orientará sobre las actividades y necesidades actuales.</p></li><li><h3>Prepárate para acompañar</h3><p>Coordina los siguientes pasos con la fundación antes de acudir a una actividad.</p></li></ol><a class="button" href={`mailto:${site.email}?subject=${encodeURIComponent('Quiero participar como voluntario')}`}>Escribir al equipo de voluntariado ↗</a><p class="archive-note">Coordina tu disponibilidad y los siguientes pasos directamente con el equipo de la fundación.</p></div></div></Layout>
