---
import EditableText from '../components/EditableText.astro';
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import {Image} from 'astro:assets';import {media,community} from '../data/media';import {site} from '../data/site';
---
<Layout title="Voluntariado: comparte tu tiempo | Fundación Bull & Bear" description="Comparte tus habilidades y tu tiempo con Bull & Bear Foundation. Conoce cómo acercarte al equipo para participar en actividades de voluntariado."><PageIntro eyebrow="Voluntariado" title="Estar presente.<br/><em>Eso también transforma.</em>" description="Tu tiempo y tus habilidades pueden convertirse en compañía, aprendizaje y nuevos vínculos."/><div class="container page-body split"><div><Image class="wide-image" src={media(community)} alt="Voluntarios y participantes en un encuentro al aire libre" width={850} height={850} format="webp" loading="eager"/></div><div><p class="eyebrow">Cómo participar</p><EditableText as="h2" contentId="copy-14e5692048310c68ba8317cc" fallback={"Demos el primer paso."}/><ol class="steps"><li><EditableText as="h3" contentId="copy-499ee0e702e8bed140dea8c3" fallback={"Cuéntanos de ti"}/><EditableText as="p" contentId="copy-ef1673a0961d2524a32974a5" fallback={"Escríbenos con tus intereses, habilidades y disponibilidad."}/></li><li><EditableText as="h3" contentId="copy-72f5b15b21672fc0f91da6ef" fallback={"Conoce las oportunidades"}/><EditableText as="p" contentId="copy-09c6659fe20b3ff4e6daa62d" fallback={"El equipo te orientará sobre las actividades y necesidades actuales."}/></li><li><EditableText as="h3" contentId="copy-99f6b6f01ce8875a07942cd3" fallback={"Prepárate para acompañar"}/><EditableText as="p" contentId="copy-5d8331de1c3304c2f55e910e" fallback={"Coordina los siguientes pasos con la fundación antes de acudir a una actividad."}/></li></ol><a class="button" href={`mailto:${site.email}?subject=${encodeURIComponent('Quiero participar como voluntario')}`}>Escribir al equipo de voluntariado ↗</a><EditableText as="p" contentId="copy-f224010e7787c99cbf5304e9" fallback={"Coordina tu disponibilidad y los siguientes pasos directamente con el equipo de la fundación."} class="archive-note"/></div></div></Layout>
