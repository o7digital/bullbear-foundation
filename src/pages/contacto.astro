---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import {site} from '../data/site';
---
<Layout title="Contacto y ubicación | Fundación Bull & Bear" description="Contacta a Bull & Bear Foundation en Ciudad de México. Escríbenos a contacto@bullandbear-foundation.com o llama al +52 55 3688 8077."><PageIntro eyebrow="Contacto" title="Una conversación.<br/><em>Muchas posibilidades.</em>" description="Para participar, proponer una colaboración o conocer más de nuestra labor, aquí estamos."/><div class="container page-body contact-grid"><div><section class="contact-card"><h2>Escríbenos</h2><a href={`mailto:${site.email}`}>{site.email}</a></section><section class="contact-card"><h2>Llámanos</h2><a href="tel:+525536888077">{site.phone}</a></section><section class="contact-card"><h2>Encuéntranos</h2><p>{site.address}</p><a class="text-link" style="font:500 .85rem var(--sans);margin-top:20px" href="https://www.google.com/maps/search/?api=1&query=Av.+Insurgentes+Sur+716+Ciudad+de+Mexico" target="_blank" rel="noopener noreferrer">Ver ubicación en el mapa ↗</a><p style="font-size:.8rem;margin-top:20px">Ponte en contacto con el equipo para coordinar una visita.</p></section></div><aside class="contact-aside"><p class="eyebrow">Conectemos intenciones</p><h2>Tu idea puede ser<br/><em>el comienzo.</em></h2><p>¿Quieres organizar una colecta, compartir tus habilidades o participar con tu comunidad? Cuéntanos qué tienes en mente.</p><a class="button button-light" href={`mailto:${site.email}?subject=${encodeURIComponent('Quiero colaborar con la fundación')}`}>Proponer una colaboración ↗</a></aside></div></Layout>
