---
import EditableText from '../components/EditableText.astro';
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import {site} from '../data/site';
---
<Layout title="Contacto y ubicación | Fundación Bull & Bear" description="Contacta a Bull & Bear Foundation en Ciudad de México. Escríbenos a contacto@bullandbear-foundation.com o llama al +52 55 3688 8077."><PageIntro eyebrow="Contacto" title="Una conversación.<br/><em>Muchas posibilidades.</em>" description="Para participar, proponer una colaboración o conocer más de nuestra labor, aquí estamos."/><div class="container page-body contact-grid"><div><section class="contact-card"><EditableText as="h2" contentId="copy-75b7c438da36759db4d4ec4a" fallback={"Escríbenos"}/><a href={`mailto:${site.email}`}>{site.email}</a></section><section class="contact-card"><EditableText as="h2" contentId="copy-4c40604ba1b9e3c0d3241b44" fallback={"Llámanos"}/><a href="tel:+525536888077">{site.phone}</a></section><section class="contact-card"><EditableText as="h2" contentId="copy-dd250bb50649cb8960cb23ff" fallback={"Encuéntranos"}/><p>{site.address}</p><a class="text-link" style="font:500 .85rem var(--sans);margin-top:20px" href="https://www.google.com/maps/search/?api=1&query=Av.+Insurgentes+Sur+716+Ciudad+de+Mexico" target="_blank" rel="noopener noreferrer">Ver ubicación en el mapa ↗</a><EditableText as="p" contentId="copy-a54c8d1b19fe3613dc4dfe11" fallback={"Ponte en contacto con el equipo para coordinar una visita."} style="font-size:.8rem;margin-top:20px"/></section></div><aside class="contact-aside"><p class="eyebrow">Conectemos intenciones</p><h2>Tu idea puede ser<br/><em>el comienzo.</em></h2><EditableText as="p" contentId="copy-b46b8886f6ca3d836408eae7" fallback={"¿Quieres organizar una colecta, compartir tus habilidades o participar con tu comunidad? Cuéntanos qué tienes en mente."}/><a class="button button-light" href={`mailto:${site.email}?subject=${encodeURIComponent('Quiero colaborar con la fundación')}`}>Proponer una colaboración ↗</a></aside></div></Layout>
